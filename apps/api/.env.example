# Copy to .env and adjust. SQLite is the default dev datastore.
DATABASE_URL="file:./dev.db"

# REQUIRED in production. Use a long random string (>= 32 chars).
JWT_SECRET="dev-only-change-me-to-a-long-random-secret-string"

# HTTP
PORT=4000
HOST=0.0.0.0

# Comma-separated list of allowed browser origins (dashboard + widget hosts).
# Use "*" to allow all (development only).
CORS_ORIGINS="http://localhost:5173,http://localhost:4173,http://localhost:5174"

# JWT access-token lifetime in seconds (default 12h).
JWT_TTL_SECONDS=43200

NODE_ENV=development
