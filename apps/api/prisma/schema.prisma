generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String      @id @default(cuid())
  slug        String      @unique
  displayName String
  createdAt   DateTime    @default(now())
  users       Membership[]
  apiKeys     ApiKey[]
  bikeModels  BikeModel[]
  fitSessions FitSession[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  fullName     String
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model Membership {
  userId    String
  tenantId  String
  role      String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
}

model ApiKey {
  id         String   @id @default(cuid())
  tenantId   String
  keyHash    String   @unique
  label      String
  createdAt  DateTime @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BikeModel {
  id             String   @id @default(cuid())
  tenantId       String
  modelName      String
  discipline     String
  geometryJson   Json
  frameOptions   Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fitSessions    FitSession[]

  @@index([tenantId, discipline])
}

model FitSession {
  id                    String   @id @default(cuid())
  tenantId              String
  bikeModelId           String
  riderProfileJson      Json
  recommendationJson    Json
  source                String
  createdAt             DateTime @default(now())
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bikeModel             BikeModel @relation(fields: [bikeModelId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
}
