# PostgreSQL connection for Prisma. The app runs without a DB (3D + fit engine
# are client-side; the /api/fit endpoint is DB-free). A DB is only needed to
# persist riders, bikes and fit sessions.
DATABASE_URL="postgresql://fitwerx:fitwerx@localhost:5432/digitaltwin?schema=public"

